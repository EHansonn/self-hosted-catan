# Creator-only password required to create a room. Guests do not need it.
# Optional: otherwise a random password is generated in the Docker data volume.
# Use at least 12 characters. Never commit the actual password.
ROOM_CREATE_PASSWORD=
# Optional visible application name. No image rebuild is required.
APP_NAME=Crossroads
PORT=8080
# Loopback only by default. Use your machine's private LAN IP for trusted access.
BIND_ADDRESS=127.0.0.1
# Enable when running behind your own HTTPS reverse proxy.
SECURE_COOKIE=false
# Optional exact origins for an explicit reverse-proxy setup, comma-separated.
ALLOWED_ORIGINS=
# Trust client-address proxy headers only when direct access is blocked.
TRUST_PROXY_HEADERS=false
# Optional delay before an absent player's seat switches to bot control.
PLAYER_DISCONNECT_GRACE_MS=120000

# Optional image Compose settings. Use an exact published image and version.
# GAME_IMAGE=registry.example/self-hosted-crossroads:1.0.0
# GAME_MEMORY_LIMIT=256m
# GAME_CPU_LIMIT=0.50
