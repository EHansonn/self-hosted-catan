# Required to create rooms. Guests and spectators do not need this password.
ROOM_CREATE_PASSWORD=replace-with-a-long-unique-password

# Public hostname only, without https://, a port or a path.
PUBLIC_HOSTNAME=game.example.com

# Secret token from a remotely managed Cloudflare Tunnel.
CF_TUNNEL_TOKEN=replace-with-the-cloudflare-tunnel-token

# Optional application and container limits.
APP_NAME=Crossroads
PLAYER_DISCONNECT_GRACE_MS=120000
GAME_MEMORY_LIMIT=256m
GAME_CPU_LIMIT=0.50
